rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Anyone can view projects and categories.
    // Only a signed-in admin (Firebase Auth) can create, edit, or delete.
    match /projects/{projectId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
